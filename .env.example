# Complete Omics LabOS Final 11.1 - production environment example
# Generate a unique long random value. Never commit the real production secret.
LIS_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Permanent public HTTPS address used in secure provider links.
PUBLIC_BASE_URL=https://labos.completeomics.com

# Use managed PostgreSQL in production. Example only; do not reuse these credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/labos

COOKIE_SECURE=1
REQUIRE_PRIVILEGED_MFA=1
IDLE_TIMEOUT_MINUTES=20
LOGIN_FAILURE_LIMIT=5
LOGIN_LOCKOUT_MINUTES=15
AUDIT_RETENTION_YEARS=6
